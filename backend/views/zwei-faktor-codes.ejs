<!doctype html><meta charset="utf-8"><title><%= appName %> — Wiederherstellungscodes</title>
<%- include('partials/favicon') %>
<%# Grundfarbe kritisch inline — sonst malt der Browser vor dem Stylesheet
    kurz seinen hellen Standard (derselbe Grund wie in partials/head.ejs). %>
<%# Ohne diese Zeile rendert ein Handy die Seite auf gedachten 980px und
    zoomt heraus -- alles wirkt winzig. Bewusst NUR hier: die Anwendung
    selbst (Fenster, Desktop) braucht einen eigenen Ansatz. %>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<style>html{background:#375998;color-scheme:light}</style>
<link rel="stylesheet" href="<%= base %>/static/css/glass.css?v=<%= v %>">
<link rel="stylesheet" href="<%= base %>/static/css/login.css?v=<%= v %>">
<%# Einmalige Anzeige: gespeichert sind nur Hashes, ein zweites Mal gibt es
    diese Liste nicht (nur neue). %>
<form method="get" action="<%= weiter %>" class="breit glass">
  <h1><img src="<%= base %>/static/img/relay.svg" alt="" width="26" height="26">Wiederherstellungscodes</h1>
  <p class="hinweis"><strong>Jetzt sichern.</strong> Diese Liste erscheint kein
    zweites Mal. Jeder Code funktioniert genau einmal statt der sechsstelligen
    Zahl — für den Fall, dass das Handy weg ist.</p>
  <ul class="codes">
    <% codes.forEach(function (c) { %><li><code><%= c %></code></li><% }) %>
  </ul>
  <button>Ich habe sie gesichert</button>
</form>
