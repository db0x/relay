# Secrets — niemals ins Repo (JWT/FILE/SESSION_SECRET, INSTANCE_NAME etc.)
.env

# Nutzerdaten: echte Dokumente und die Nutzerdatenbank (gehashte Passwörter, API-Token)
documents/
state/
docs/

# Ersatz-Einhängepunkt der geteilten Bibliothek, wenn SHARED_LIB leer ist
# (docker-compose braucht einen Pfad). Bleibt leer, der Ordner selbst nicht ins Repo.
library/*
!library/.gitkeep

# Node
node_modules/
npm-debug.log*

# E2E-Tests: Artefakte der Läufe (Screenshots, Traces, HTML-Report)
test-results/
playwright-report/

# Betriebssystem-/Editor-Reste
.DS_Store
*.swp
.vscode
.claude