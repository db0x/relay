<!doctype html><meta charset="utf-8"><title><%= appName %> — Zwei-Faktor einrichten</title>
<%- include('partials/favicon') %>
<link rel="stylesheet" href="<%= base %>/static/css/login.css?v=<%= v %>">
<%# Der QR-Code wird serverseitig als SVG erzeugt (qrcode-svg) und steht direkt
    im Markup — kein externes Laden, keine Ausnahme in der CSP noetig. %>
<form method="post" action="<%= base %>/zwei-faktor/einrichten" class="breit">
  <h1><img src="<%= base %>/static/img/relay.svg" alt="" width="26" height="26">Zwei-Faktor einrichten</h1>
  <p class="hinweis">Verwaltungszugänge brauchen eine zweite Stufe. Scanne den
    Code mit einer Authenticator-App und tippe zur Probe die Zahl ein, die sie
    dir anzeigt — erst dann wird die Stufe scharf geschaltet.</p>
  <div class="qr"><%- qr %></div>
  <p class="hinweis">Keine Kamera? Dann das Geheimnis von Hand eintragen:<br>
    <code class="geheim"><%= geheimnis %></code></p>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <input name="code" inputmode="numeric" autocomplete="one-time-code"
         placeholder="123456" required autofocus>
  <button>Prüfen und aktivieren</button>
  <div class="version"><a href="<%= base %>/logout">Abmelden</a></div>
</form>
