<%# Nachrichten-Uebersicht: wer hat mir was wann freigegeben. Geoeffnet ueber
    den Avatar in der Titelleiste (js/notifications.js).
    Ein Klick auf einen Eintrag springt in der Dateiliste zu der Datei und
    entfernt die Nachricht (gelesen = geloescht). %>
<dialog id="dlg-notif" class="dialog dialog-notif">
  <header class="dialog-head">
    <img src="<%= base %>/static/img/share.svg" alt="" width="22" height="22">
    <h2>Nachrichten</h2>
    <form method="dialog">
      <button class="dialog-x" aria-label="Schließen">×</button>
    </form>
  </header>

  <div class="notif-box">
    <ul class="notif-list" id="notif-list">
      <% notifications.forEach(function(n){ %>
      <li>
        <button type="button" class="notif-item" data-id="<%= n.id %>"
                data-owner="<%= n.owner %>" data-rel="<%= n.relpath %>">
          <span class="notif-text">
            <strong><%= n.ownerName %></strong> hat
            „<%= n.label %>“ für dich freigegeben<% if (n.perm === "view") { %> (nur lesen)<% } %>
          </span>
          <span class="notif-when"><%= n.when %></span>
        </button>
      </li>
      <% }); %>
    </ul>
    <p class="notif-empty muted" id="notif-empty"<%= notifications.length ? " hidden" : "" %>>
      Keine neuen Nachrichten.
    </p>

    <%# Alles wegraeumen — hier statt im Kebab-Menue, weil es zu den
        Nachrichten gehoert. Rueckfrage, weil dabei geloescht wird. %>
    <div class="notif-foot">
      <form action="<%= base %>/notifications/read-all" method="post"
            data-confirm="Alle Nachrichten als gelesen markieren? Sie werden dabei entfernt.">
        <button class="btn btn-secondary btn-sm" id="notif-read-all"
                <%= notifications.length ? "" : "disabled" %>>Alle als gelesen markieren</button>
      </form>
    </div>
  </div>
</dialog>
