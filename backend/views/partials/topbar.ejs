<header class="topbar">
    <div class="topbar-left">
    <%# Klick auf Logo/Name fuehrt zurueck zur Startseite ("Meine Dateien") %>
    <a class="brand" href="<%= base %>/" data-tip="Zur Startseite" aria-label="Zur Startseite">
      <img src="<%= base %>/static/img/logo.svg" alt="" width="28" height="28">
      <span><%= appName %></span>
    </a>
    <%# Werkzeugleiste: nur noch die Ansicht-Umschalter. Alles, was auf EINE
        Ansicht wirkt (neue Datei, Hochladen, Neuer Ordner, neue Notiz), sitzt
        in der Titelleiste des jeweiligen Fensters — siehe file-list.ejs und
        board.ejs. %>
    <section class="toolbar" aria-label="Ansichten">
      <div class="tool-icons">
      <%# Umschalter fuer die Dateiliste: immer da, aria-pressed spiegelt, ob
          das Fenster gerade offen ist (js/desktop-layout.js). Serverseitig
          vorbelegt, damit der Zustand ohne Aufblitzen stimmt. %>
      <button type="button" class="view-btn" id="page-toggle"
              data-tip="Meine Dateien" aria-label="Dateiliste anzeigen oder ausblenden"
              aria-pressed="<%= pageLayout && pageLayout.minimized ? "false" : "true" %>">
        <img src="<%= base %>/static/img/file-manager.svg" alt="" width="26" height="26">
      </button>
      <%# Umschalter fuer das Notiz-Board (gleiche Mechanik, eigener Schluessel) %>
      <button type="button" class="view-btn" id="board-toggle"
              data-tip="Notiz-Board" aria-label="Notiz-Board anzeigen oder ausblenden"
              aria-pressed="<%= boardLayout && !boardLayout.minimized ? "true" : "false" %>">
        <img src="<%= base %>/static/img/board.svg" alt="" width="26" height="26">
      </button>
      </div><%# Ende .tool-icons %>
      <%# "Hochladen" und "Neuer Ordner" sitzen NICHT hier, sondern in der
          Titelleiste des Dateifensters (partials/file-list.ejs): sie wirken
          auf den gerade angezeigten Ordner und gehoeren damit zu dieser
          Ansicht — nicht in die globale Werkzeugleiste. %>
    </section>
    </div>
    <div class="user">
      <%# Avatar ist zugleich der Zugang zu den Nachrichten — als MENUE, genau
          wie der Kebab daneben: dieselbe .menu/.menu-btn/.menu-panel-Struktur,
          damit js/core/dialogs.js (bindMenuButtons) das Oeffnen, Schliessen
          per Escape und den Klick daneben ohne Zusatzcode uebernimmt.
          Die Glocke erscheint nur, wenn etwas offen ist; ab 10 steht "9+". %>
      <div class="menu notif-menu">
        <button type="button" class="avatar-btn menu-btn" id="notif-btn"
                aria-haspopup="true" aria-expanded="false"
                data-tip="<%= notifications.length ? "Neue Nachrichten" : "Nachrichten" %>"
                aria-label="Nachrichten anzeigen">
          <% if (hasAvatar) { %>
          <img class="avatar" src="<%= base %>/avatar/<%= encodeURIComponent(me) %>" alt="" width="32" height="32">
          <% } else { %>
          <span class="avatar avatar-initial"><%= (user || me).trim().charAt(0).toUpperCase() %></span>
          <% } %>
          <span class="notif-badge" id="notif-badge"
                <%= notifications.length ? "" : "hidden" %>>
            <img src="<%= base %>/static/img/bell.svg" alt="" width="16" height="16">
            <span class="notif-count" id="notif-count"><%= notifications.length > 9 ? "9+" : notifications.length %></span>
          </span>
        </button>

        <div class="menu-panel notif-panel" id="notif-panel" hidden>
          <div class="notif-head">
            <img src="<%= base %>/static/img/share.svg" alt="" width="16" height="16">
            <span>Nachrichten</span>
          </div>
          <ul class="notif-list" id="notif-list">
            <% notifications.forEach(function(n){ %>
            <li>
              <button type="button" class="menu-item notif-item" data-id="<%= n.id %>"
                      data-owner="<%= n.owner %>" data-rel="<%= n.relpath %>">
                <span class="notif-text">
                  <strong><%= n.ownerName %></strong> hat
                  „<%= n.label %>“ für dich freigegeben<% if (n.perm === "view") { %> (nur lesen)<% } %>
                </span>
                <span class="notif-when"><%= n.when %></span>
              </button>
            </li>
            <% }); %>
          </ul>
          <p class="notif-empty muted" id="notif-empty"<%= notifications.length ? " hidden" : "" %>>
            Keine neuen Nachrichten.
          </p>
          <%# Alles wegraeumen — Rueckfrage, weil dabei geloescht wird %>
          <form action="<%= base %>/notifications/read-all" method="post"
                data-confirm="Alle Nachrichten als gelesen markieren? Sie werden dabei entfernt.">
            <button class="menu-item notif-read-all" id="notif-read-all"
                    <%= notifications.length ? "" : "disabled" %>>Alle als gelesen markieren</button>
          </form>
        </div>
      </div>
      <span class="uname"><%= user %></span>
      <div class="menu">
        <%# id fuers gezielte Ansprechen: seit den Nachrichten gibt es zwei
            .menu-btn in der Titelleiste (Avatar und dieser Kebab). %>
        <button type="button" class="iconbtn menu-btn" id="main-menu-btn"
                aria-haspopup="true"
                aria-expanded="false" aria-label="Menü" data-tip="Menü">
          <img src="<%= base %>/static/img/open-menu.svg" alt="" width="16" height="16">
        </button>
        <div class="menu-panel" hidden>
          <button type="button" class="menu-item" data-dialog="dlg-account">Mein Konto</button>
          <% if (isAdmin) { %>
          <button type="button" class="menu-item" data-dialog="dlg-users">Nutzerverwaltung</button>
          <button type="button" class="menu-item" data-dialog="dlg-settings">Einstellungen</button>
          <button type="button" class="menu-item" data-dialog="dlg-backup">Backup</button>
          <% } %>
          <a class="menu-item" href="<%= base %>/logout">Abmelden</a>
          <div class="menu-version">Relay v<%= version %></div>
        </div>
      </div>
    </div>
  </header>
