<!doctype html><meta charset="utf-8"><title><%= appName %> — Anmelden</title>
<%- include('partials/favicon') %>
<%# Grundfarbe kritisch inline — sonst malt der Browser vor dem Stylesheet
    kurz seinen hellen Standard (derselbe Grund wie in partials/head.ejs). %>
<%# Ohne diese Zeile rendert ein Handy die Seite auf gedachten 980px und
    zoomt heraus -- alles wirkt winzig. Bewusst NUR hier: die Anwendung
    selbst (Fenster, Desktop) braucht einen eigenen Ansatz. %>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<style>html{background:#375998;color-scheme:light}</style>
<link rel="stylesheet" href="<%= base %>/static/css/glass.css?v=<%= v %>">
<link rel="stylesheet" href="<%= base %>/static/css/login.css?v=<%= v %>">
<form method="post" action="<%= base %>/login" class="glass">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h1><img src="<%= base %>/static/img/relay.svg" alt="" width="26" height="26"><%= appName %></h1>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <input name="username" placeholder="Name" autofocus autocomplete="username">
  <input name="password" type="password" placeholder="Passwort"
         autocomplete="current-password">
  <input type="hidden" name="next" value="<%= next %>">
  <button>Anmelden</button>
</form>
<script nonce="<%= nonce %>">
  // Cursor direkt ins Namensfeld setzen — das autofocus-Attribut greift in
  // eingebetteten Ansichten (Voltage-Webview) nicht zuverlaessig. Hat der
  // Browser den Namen schon ausgefuellt, direkt weiter ins Passwortfeld.
  window.addEventListener("DOMContentLoaded", function () {
    var u = document.querySelector("input[name=username]");
    var p = document.querySelector("input[name=password]");
    (u.value ? p : u).focus();
  });
</script>
