<%# page-min schon serverseitig setzen: so ist die Karte beim Laden gar nicht
    erst da, statt kurz aufzublitzen und dann von JS eingeklappt zu werden. %>
<%# data-dir: der gerade angezeigte Ordner. Die AJAX-Ordnernavigation liest ihn
    nach dem Tausch aus und zieht die versteckten dir-Felder der Dialoge
    ausserhalb von #page nach (js/folder-nav.js: syncDirFields). %>
<div class="page<%= pageLayout && pageLayout.minimized ? " page-min" : "" %>" id="page" data-dir="<%= curDir %>"<% if (pageLayout) { %> data-x="<%= pageLayout.x %>" data-y="<%= pageLayout.y %>"<% } %>>
  <%# Titelleiste: zugleich Greif-Flaeche zum Verschieben (der Minimieren-Knopf
      ist ein <button> und damit von der Zieh-Logik ausgenommen, siehe
      pageDragSkip in js/desktop-layout.js) %>
  <header class="page-head">
    <img src="<%= base %>/static/img/file-manager.svg" alt="" width="22" height="22">
    <h2 class="page-title">Meine Dateien</h2>
    <%# Die "neu"-Icons sind in das Anwendungs-Menue am Logo umgezogen
        (partials/topbar.ejs). Hier bleiben die Aktionen, die auf den GERADE
        angezeigten Ordner wirken. Sie stehen bewusst hier statt in der Topbar
        — und weil sie damit innerhalb von #page liegen, tauscht die AJAX-
        Ordnernavigation sie beim Ordnerwechsel mit aus; das versteckte
        dir-Feld zeigt so immer auf den richtigen
        Ordner (siehe syncDirFields in js/folder-nav.js fuer die Dialoge,
        die ausserhalb liegen). %>
    <%# page-head-end: alles ab hier rueckt an den rechten Rand (margin-left:auto) %>
    <div class="page-actions page-head-end">
      <%# ein Knopf: oeffnet die Dateiauswahl, die Auswahl laedt sofort hoch (js/files/upload.js) %>
      <form class="upload-form" action="<%= base %>/upload?_csrf=<%= csrf %>" method="post" enctype="multipart/form-data"
            data-max-mb="<%= maxUploadMb %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="dir" value="<%= curDir %>">
        <input type="file" name="file" accept="<%= uploadAccept %>" hidden>
        <button type="button" class="btn btn-secondary btn-sm upload-btn" data-tip="Datei hochladen" aria-label="Datei hochladen">
          <img class="btn-icon" src="<%= base %>/static/img/upload.svg" alt="" width="16" height="16"><span class="tool-label">Hochladen</span>
        </button>
      </form>
      <button type="button" class="btn btn-secondary btn-sm" data-dialog="dlg-mkdir" data-tip="Neuer Ordner" aria-label="Neuer Ordner">
        <img class="btn-icon" src="<%= base %>/static/img/folder.svg" alt="" width="16" height="16"><span class="tool-label">Neuer Ordner</span>
      </button>
    </div>
    <button type="button" class="iconbtn page-min-btn" id="page-minimize"
            data-tip="Minimieren" aria-label="Dateiliste minimieren">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
        <rect x="2" y="6.2" width="10" height="1.6" rx=".8" fill="currentColor"/>
      </svg>
    </button>
  </header>

  <% if (crumbs.length > 1) { %>
  <nav class="crumbs">
    <% crumbs.forEach(function(c, i){ %>
      <% if (i) { %><span class="crumb-sep">/</span><% } %>
      <% if (i === crumbs.length - 1) { %>
      <span class="crumb current"><%= c.label %></span>
      <% } else { %>
      <a class="crumb" href="<%= c.href %>"><%= c.label %></a>
      <% } %>
    <% }); %>
  </nav>
  <% } %>

  <div class="table-wrap">
    <table class="files">
      <thead>
        <tr>
          <% columns.forEach(function(c){ %>
          <th class="<%= c.cls %>">
            <a class="sort<%= c.active ? ' active' : '' %>" href="<%= c.href %>">
              <%= c.label %><span class="arrow"><%= c.arrow %></span>
            </a>
          </th>
          <% }); %>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% if (files.length) { files.forEach(function(f, i){ %>
        <tr<%- f.isOwner ? "" : ' class="row-foreign"' %>>
          <td class="col-name">
            <div class="file-cell">
              <%# Notizen als <use> aufs <symbol> — nur so traegt das Icon die
                  Farbe der Notiz (gleiche wie auf dem Desktop) %>
              <% if (f.isNote) { %>
              <svg class="ficon note-ico<%= f.noteColor ? " note-colored" : "" %><%= f.noteDark ? " note-dark" : "" %>"
                   width="28" height="28" aria-hidden="true" focusable="false"
                   <% if (f.noteColor) { %>style="--note-color:<%= f.noteColor %>"<% } %>><use href="#note-ico"/></svg>
              <% } else if (f.isImage) { %>
              <%# echtes Vorschaubild statt Einheits-Icon (serverseitig
                  verkleinert, siehe routes/images.js). Schlaegt das Laden fehl
                  (kaputte Datei), blendet js/files/image-view.js das
                  image.svg-Icon ein. %>
              <img class="ficon ficon-thumb" alt="" width="28" height="28"
                   src="<%= base %>/thumb/<%= encodeURIComponent(f.owner) %>/<%= encPath(f.relpath) %>"
                   data-fallback="<%= base %>/static/img/image.svg">
              <% } else { %>
              <img class="ficon" src="<%= base %>/static/img/<%= f.icon %>.svg" alt="" width="28" height="28">
              <% } %>
              <span class="fname-wrap">
                <% if (f.isDir) { %>
                <a class="fname" href="<%= base %>/?p=<%= encodeURIComponent(f.relpath) %>"><%= f.label %></a>
                <% } else if (f.isNote) { %>
                <button type="button" class="fname note-open" data-owner="<%= f.owner %>"
                        data-rel="<%= f.relpath %>" data-label="<%= f.label %>"
                        data-canedit="<%= (f.isOwner || f.perm === "edit") ? 1 : 0 %>"
                        data-isowner="<%= f.isOwner ? 1 : 0 %>"><%= f.label %></button>
                <% } else if (f.isImage) { %>
                <%# Bilder kann OnlyOffice nicht oeffnen -> eigener
                    Vorschau-Dialog (js/files/image-view.js) %>
                <button type="button" class="fname image-open"
                        data-src="<%= base %>/image/<%= encodeURIComponent(f.owner) %>/<%= encPath(f.relpath) %>"
                        data-download="<%= base %>/download/<%= encodeURIComponent(f.owner) %>/<%= encPath(f.relpath) %>"
                        data-label="<%= f.label %>"><%= f.label %></button>
                <% } else { %>
                <a class="fname" href="<%= base %>/edit/<%= encodeURIComponent(f.owner) %>/<%= encPath(f.relpath) %>"><%= f.label %></a>
                <% } %>
                <% if (f.todo) { %>
                <span class="badge badge-todo<%= f.todo.overdue ? " badge-todo-over" : "" %>">ToDo<%= f.todo.dueLabel ? " · fällig " + f.todo.dueLabel : "" %></span>
                <% } %>
                <% if (!f.isOwner) { %>
                <span class="badge">von <%= f.ownerName %><% if (f.perm === "view") { %> · nur lesen<% } %></span>
                <% } else if (f.shares.length) { %>
                <span class="badge badge-soft share-badge" tabindex="0">geteilt · <%= f.shares.length %>
                  <span class="share-tip" role="tooltip">
                    <% f.shares.forEach(function(s){ %>
                    <span class="share-tip-row">
                      <% if (s.hasAvatar) { %>
                      <img src="<%= base %>/avatar/<%= encodeURIComponent(s.target) %>" alt="" width="22" height="22">
                      <% } else { %>
                      <span class="share-tip-fallback"><%= (s.display_name || s.target).trim().charAt(0).toUpperCase() %></span>
                      <% } %>
                      <span class="share-tip-name"><%= s.display_name %></span>
                      <span class="share-tip-perm"><%= s.perm === "edit" ? "Bearbeiten" : "Nur lesen" %></span>
                    </span>
                    <% }); %>
                  </span>
                </span>
                <% } %>
              </span>
            </div>
          </td>
          <td class="col-size"><%= f.size %></td>
          <td class="col-date"><%= f.modified %></td>
          <td class="col-actions">
            <%# alle Aktionen in EINEM Kontextmenue pro Zeile (Kebab-Knopf) %>
            <div class="row-menu">
              <button type="button" class="iconbtn row-menu-btn" aria-haspopup="true"
                      aria-expanded="false" data-tip="Aktionen" aria-label="Aktionen">
                <img src="<%= base %>/static/img/open-menu.svg" alt="" width="16" height="16">
              </button>
              <div class="menu-panel row-menu-panel" hidden>
                <% if (f.isDir) { %>
                <form class="del-form" action="<%= base %>/rmdir/<%= encPath(f.relpath) %>" method="post"
                      data-confirm="Ordner „<%= f.label %>“ löschen? Das geht nur, wenn er leer ist.">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="dir" value="<%= curDir %>">
                  <button class="menu-item menu-item-ico menu-item-danger">
                    <img src="<%= base %>/static/img/delete.svg" alt="" width="16" height="16">Löschen
                  </button>
                </form>
                <% } else { %>
                <a class="menu-item menu-item-ico" href="<%= base %>/download/<%= encodeURIComponent(f.owner) %>/<%= encPath(f.relpath) %>">
                  <img src="<%= base %>/static/img/download.svg" alt="" width="16" height="16">Herunterladen
                </a>
                <% if (f.isOwner) { %>
                <button type="button" class="menu-item menu-item-ico" data-dialog="dlg-move-<%= i %>">
                  <img src="<%= base %>/static/img/move.svg" alt="" width="16" height="16">Verschieben
                </button>
                <button type="button" class="menu-item menu-item-ico" data-dialog="dlg-share-<%= i %>">
                  <img src="<%= base %>/static/img/share.svg" alt="" width="16" height="16">Freigeben
                </button>
                <form class="del-form" action="<%= base %>/delete/<%= encodeURIComponent(f.owner) %>/<%= encPath(f.relpath) %>" method="post"
                      data-confirm="„<%= f.label %>“ wirklich löschen? Das lässt sich nicht rückgängig machen.">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="dir" value="<%= curDir %>">
                  <button class="menu-item menu-item-ico menu-item-danger">
                    <img src="<%= base %>/static/img/delete.svg" alt="" width="16" height="16">Löschen
                  </button>
                </form>
                <% } %>
                <% } %>
              </div>
            </div>
          </td>
        </tr>
        <% }); } else { %>
        <tr><td class="empty" colspan="4">Dieser Ordner ist leer — oben eine Datei anlegen oder hochladen.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (files.some(function(f){ return !f.isOwner; })) { %>
  <%# Fusszeile mit Filter: nur sichtbar, wenn es ueberhaupt Freigaben gibt %>
  <footer class="list-footer">
    <label class="switch-label">
      <input type="checkbox" id="own-only">
      <span class="switch-ui" aria-hidden="true"></span>
      <span class="switch-text">Nur eigene Dateien</span>
    </label>
  </footer>
  <% } %>
</div><%# Ende .page — Overlays (Dialoge, Tooltips, Backdrop) liegen BEWUSST
         ausserhalb: .page ist position:fixed und damit ein Stacking-Context;
         innerhalb wuerden Dialoge/Tooltips unter die Notiz-Icons/Topbar gedrueckt %>
