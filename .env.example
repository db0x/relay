# Relay configuration — copy to .env and adjust. The real .env is gitignored
# (secrets!); this template documents all variables.

# LAN address/hostname of this machine; used to build PUBLIC_DS_URL
# (browser -> DocumentServer): http://<SERVER_HOST>:<DS_PORT>
SERVER_HOST=192.168.1.10

# Display name of this instance in the UI (title, header, login). Default: Relay
INSTANCE_NAME=Relay

# Sub-path behind a reverse proxy, e.g. /relay for http://moria/relay.
# Leave empty when Relay runs at the root.
BASE_PATH=

# Host ports: web UI and DocumentServer
# (5000 instead of 8080 as the DS default — 8080 is often taken already)
UI_PORT=5001
DS_PORT=5000

# Browser-facing URL of the DocumentServer. Empty = http://<SERVER_HOST>:<DS_PORT>.
# Behind nginx with the /ds proxy (see deploy/nginx-relay.conf.example):
# PUBLIC_DS_URL=http://moria/ds
PUBLIC_DS_URL=

# Bind address of the container ports. Default 0.0.0.0 (reachable on the LAN).
# Behind nginx on the same host: 127.0.0.1 — then only port 80 is exposed.
# MANDATORY (127.0.0.1) for any installation reachable from the internet:
# the container ports must never be exposed directly.
BIND_ADDR=

# Number of trusted reverse proxies in front of Relay. 0/empty = none.
# Behind an nginx on the same host: 1. Only with this set does Relay believe
# X-Forwarded-Proto (needed for the Secure cookie flag over TLS) and
# X-Forwarded-For (source address for the login rate limit). Never set it
# without a proxy — the headers would be attacker-controlled.
TRUST_PROXY=

# Extra hardening overlay. Docker Compose reads COMPOSE_FILE from here, so
# setting it once makes plain `docker compose up -d --build` pick the overlay
# up. See deploy/docker-compose.haertung.yml — it adds no-new-privileges,
# which does NOT work on rootless Docker (the container then fails to start).
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.haertung.yml

# Restrict ADMIN accounts to the local network (1 = on, empty = off).
# Normal users are unaffected and keep working from anywhere.
# The zone is decided by the ENTRANCE, not by IP ranges: each nginx server
# block sets `X-Relay-Zone: lan` or `wan` (see deploy/*.example) — public
# blocks MUST set `wan` explicitly. Without a proxy (TRUST_PROXY empty/0) the
# peer address decides instead (private ranges = lan).
# Turn this on only AFTER the nginx zones are in place — otherwise admins are
# locked out of the web UI (way back: `docker compose exec backend node manage.js`).
ADMIN_LAN_ONLY=

# Require a second factor (TOTP) for ADMIN accounts (1 = on, empty = off).
# Off does not mean "unavailable": any admin can set it up from their account
# dialog at any time, and once set up the code is ALWAYS required. This switch
# only decides whether an admin WITHOUT a second factor still gets in — with
# it on, they are sent to the setup page on their next login.
# Normal users are never asked for a code.
ADMIN_2FA=

# Key that encrypts the TOTP secrets in the database (openssl rand -hex 32).
# Optional: if empty, the key is derived from SESSION_SECRET — then changing
# SESSION_SECRET invalidates every enrolled authenticator app. Set it to keep
# the two independent. Losing it means all admins must enroll again.
# Why encrypt at all: the backup mirrors users.db to the NAS, the .env does not.
TOTP_KEY=

# Password for the bootstrap admin, used ONLY when the user table is empty
# (first start). Leave empty in production: Relay then generates a random
# one-time password, prints it once into the container log, and forces a
# change on first login.
ADMIN_PASSWORD=

# Hard per-file limit in MB, empty = 512. Applies to the file API (sync/
# Voltage) AND is written into the DocumentServer at container start
# (maxDownloadBytes — files above it cannot be opened). nginx's
# client_max_body_size must stay >= this value.
MAX_FILE_MB=

# Maximum size for uploads via the web UI, in MB. Empty = 128, capped at
# MAX_FILE_MB. Checked in the browser BEFORE uploading (friendly dialog)
# and enforced server-side.
MAX_UPLOAD_MB=

# Dir to use for backup from relay-data/configuration
BACKUP= 

# Shared media library (read only). Host path whose TOP-LEVEL subfolders can
# be granted to individual users by an admin ("Nutzerverwaltung" -> the
# "Bibliothek" button per user). The folders then show up in the file list
# marked as "Bibliothek"; videos play in a dialog, everything else can be
# downloaded. Relay never writes here — the mount is read-only (:ro).
# Empty = no library.
SHARED_LIB=

# Editor theme forced on every editor start. Empty = theme-white ("Modern
# Hell"). Other ids: theme-light, theme-classic-light, theme-dark,
# theme-night ("Modern Dunkel"), theme-contrast-dark, theme-system.
# Native font rendering is always enforced alongside (see edit.js).
EDITOR_THEME=

# Host directories for user files and the user database
# (default: ./documents and ./state inside the project folder).
# On a server e.g. /srv/relay/documents and /srv/relay/state.
DOCUMENTS_DIR=./documents
STATE_DIR=./state

# Secrets — roll ALL four anew for every fresh installation:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME
SECURE_LINK_SECRET=CHANGE_ME
FILE_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME
