<!doctype html><meta charset="utf-8"><title><%= appName %> — Dokumente</title>
<%# Kritisch, MUSS vor dem externen CSS stehen: ohne deklariertes color-scheme
    malt ein Dark-Mode-Browser beim Neuladen kurz seinen dunklen Standard-Canvas,
    bevor das Hintergrundbild greift -> schwarzer Blitz. Die Grundfarbe ist der
    Mittelton des Desktop-Bildes, damit der Moment vor dem Bild nahtlos wirkt. %>
<meta name="color-scheme" content="light">
<style>html{background:#375998;color-scheme:light}</style>
<%- include('favicon') %>
<%# Eigene Bildlaufleisten: die nativen sind auf vielen Systemen Overlay-
    Leisten, die keinen Platz belegen und ausblenden — in einem langen
    Dateifenster sah man dann nicht, dass es weitergeht (js/core/scrollbars.js).
    MUSS vor index.css stehen: die Anmutung wird dort ueber dieselben Klassen
    gesetzt (.os-scrollbar) und soll gewinnen. %>
<link rel="stylesheet" href="<%= base %>/static/vendor/overlayscrollbars.min.css?v=<%= v %>">
<link rel="stylesheet" href="<%= base %>/static/css/index.css?v=<%= v %>">
<link rel="stylesheet" href="<%= base %>/static/vendor/codemirror.min.css?v=<%= v %>">
<link rel="stylesheet" href="<%= base %>/static/vendor/highlight-github.min.css?v=<%= v %>">
<link rel="stylesheet" href="<%= base %>/static/vendor/coloris.min.css?v=<%= v %>">
<script defer src="<%= base %>/static/vendor/coloris.min.js?v=<%= v %>"></script>
<script defer src="<%= base %>/static/vendor/codemirror.min.js?v=<%= v %>"></script>
<%# CodeMirror bringt seine Bildlaufleiste selbst mit — die eingebaute ist die
    native und damit dieselbe unsichtbare wie ueberall sonst. Dieses Addon
    (scrollbarStyle:"overlay", gesetzt in js/notes/note-dialog.js) zeichnet
    stattdessen eigene Elemente; die Optik gleicht index.css an. %>
<script defer src="<%= base %>/static/vendor/cm-scrollbars.js?v=<%= v %>"></script>
<script defer src="<%= base %>/static/vendor/cm-xml.min.js?v=<%= v %>"></script>
<script defer src="<%= base %>/static/vendor/cm-markdown.min.js?v=<%= v %>"></script>
<script defer src="<%= base %>/static/vendor/marked.min.js?v=<%= v %>"></script>
<script defer src="<%= base %>/static/vendor/purify.min.js?v=<%= v %>"></script>
<script defer src="<%= base %>/static/vendor/highlight.min.js?v=<%= v %>"></script>
<%# defer laeuft VOR dem Modul unten (Dokumentreihenfolge) -> das globale
    OverlayScrollbarsGlobal steht bereit, wenn js/core/scrollbars.js es sucht %>
<script defer src="<%= base %>/static/vendor/overlayscrollbars.min.js?v=<%= v %>"></script>
<script type="module" src="<%= base %>/static/js/index.js?v=<%= v %>"></script>
