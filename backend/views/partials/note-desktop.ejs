<%# Frei platzierbare Notiz-Icons ("Desktop") — liegen als fixe Overlay-Ebene
    neben der Liste, ordnerunabhaengig immer sichtbar. Gleiche Klasse/Daten wie
    die Listen-Notizen -> Klick (oeffnen) und Hover (Vorschau) via
    js/notes/hover-preview.js; Position + Ziehen zusaetzlich in
    js/desktop-layout.js. %>
<div class="note-desktop" id="note-desktop" aria-label="Notiz-Ablage">
  <% desktopNotes.forEach(function(n){ %>
  <%# note-colored + --note-color nur bei eigener Farbe; sonst bleibt es beim
      Standard-Pink aus dem <symbol>. note-dark kippt die Ecke auf "aufhellen" %>
  <%# note-shared: mir freigegebene Notiz -> share.svg als Overlay am Icon %>
  <button type="button" class="note-open note-desk<%= n.isOwner ? "" : " note-shared" %><%= n.color ? " note-colored" : "" %><%= n.dark ? " note-dark" : "" %><%= n.status === "closed" ? " note-desk-done" : "" %>"
          data-owner="<%= n.owner %>"
          data-rel="<%= n.relpath %>" data-label="<%= n.label %>"
          data-canedit="<%= n.canedit ? 1 : 0 %>"
          data-isowner="<%= n.isOwner ? 1 : 0 %>"
          data-status="<%= n.status %>"
          <% if (n.color) { %>style="--note-color:<%= n.color %>"<% } %>
          <% if (n.pos) { %>data-x="<%= n.pos.x %>" data-y="<%= n.pos.y %>"<% } %>
          aria-label="Notiz: <%= n.label %>">
    <%# Der Wrapper traegt das Freigabe-Overlay (::after) — so haengt es am
        Icon selbst und nicht an der Knopfgeometrie %>
    <span class="note-ico-wrap">
      <svg class="note-ico" width="46" height="46" aria-hidden="true" focusable="false"><use href="#note-ico"/></svg>
    </span>
    <span class="note-desk-label"><%= n.label %></span>
  </button>
  <% }); %>
</div>

<%# Kontextmenue der Desktop-Icons (Rechtsklick): Bearbeitungsstand wechseln.
    EIN gemeinsames Panel statt eines pro Icon; die Klasse .menu-panel sorgt
    dafuer, dass die vorhandenen Schliess-Wege (Klick daneben, Escape,
    Scrollen) aus js/core/dialogs.js greifen. Befuellt/positioniert wird es
    von js/notes/status.js. %>
<div class="menu-panel note-status-menu" id="note-status-menu" role="menu" hidden>
  <button type="button" class="menu-item" role="menuitemradio" data-status="open">Offen</button>
  <button type="button" class="menu-item" role="menuitemradio" data-status="wip">In Arbeit</button>
  <button type="button" class="menu-item" role="menuitemradio" data-status="closed">Erledigt</button>
</div>
