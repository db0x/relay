<!doctype html><meta charset="utf-8"><title><%= appName %> — Passwort setzen</title>
<%- include('partials/favicon') %>
<link rel="stylesheet" href="<%= base %>/static/css/login.css?v=<%= v %>">
<%# Eigene, minimale Seite statt des Konto-Dialogs: solange must_change gesetzt
    ist, kommt der Zugang gar nicht bis zur Startseite (routes/auth.js). %>
<form method="post" action="<%= base %><%= "/passwort-setzen" %>">
  <h1><img src="<%= base %>/static/img/relay.svg" alt="" width="26" height="26">Passwort setzen</h1>
  <p class="hinweis">Hallo <%= user %> — dieser Zugang hat noch ein Einmal-Passwort.
    Bitte vergib jetzt ein eigenes, dann geht es weiter.</p>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <input name="new1" type="password" placeholder="Neues Passwort (min. 12 Zeichen)"
         autocomplete="new-password" required minlength="12" autofocus>
  <input name="new2" type="password" placeholder="Neues Passwort (wiederholen)"
         autocomplete="new-password" required minlength="12">
  <button>Speichern</button>
  <div class="version">Relay v<%= version %></div>
</form>
